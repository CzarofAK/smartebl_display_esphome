# Copy this file to .basics.yaml (dot-prefixed, gitignored) and fill in
# your own Wi-Fi/OTA/API credentials before flashing.
#
# This is the user's actual shared .basics.yaml pattern (used across
# their other Smart EBL / FRAM devices too), reproduced here rather
# than a from-scratch template - only `logger:` is deliberately absent
# (see the bottom of this file for why).
#
# Wi-Fi is this display's ACTIVE connection to Home Assistant, per user
# decision - not the onboard Ethernet PHY (see README.md "Networking").
# It rides over the ESP32-C6 co-processor (smart-ebl-display.yaml's
# esp32_hosted: block) since the P4 itself has no radio - that block
# plus this wifi: config together are what a classic ESP32's built-in
# Wi-Fi gets for free on the user's other devices; same end result, one
# extra transport layer to get there.
#
# This is completely separate from the RS232 link to smartebl
# (link_uart in smart-ebl-display.yaml) - that link carries neither
# Wi-Fi nor Ethernet, just RS232 + 12V over what LOOKS like an Ethernet
# cable (RJ45 connector) but isn't one. Don't let the connector shape
# or the word "ETH" on either board mislead you - see README.md
# "Networking" for the full picture of what's what.

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: none
  output_power: 17dB
  # Both boot loops are handled by the button/interval watchdog at the
  # bottom of this file instead - disabled here so they don't also
  # fight over when to restart.
  reboot_timeout: 0s
  on_connect:
    - logger.log: "WiFi CONNECTED"
  on_disconnect:
    - logger.log: "WiFi DISCONNECTED"
  ap:
    ssid: ${name}
    password: "xxxxxxxxxxxxxxxxxxx" # TODO: change before flashing

api:
  encryption:
    key: !secret api_encryption_key
  reboot_timeout: 0s

ota:
  - platform: esphome
    id: ota_esphome
    password: !secret password
    # A modern ESPHome (2024.6+) accepts `ota: platform: esphome` with
    # no `password:` at all and authenticates OTA via the api:
    # encryption key above instead - the separate OTA password is now
    # optional, not dropped here only to keep this template working on
    # older ESPHome releases too.

web_server:
  port: 80
  version: 3
  local: true

time:
  - platform: homeassistant
    id: homeassistant_time

button:
  - platform: restart
    name: "Restart"
    id: restart_button

# Watchdog: if neither the configured Wi-Fi nor the fallback AP came up
# within 5 minutes of boot (and stays that way for a full minute - not
# just a momentary blip during a reconnect), something is wrong enough
# that a restart is more useful than a silently offline display.
interval:
  - interval: 1min
    startup_delay: 5min
    then:
      - if:
          condition:
            and:
              - not:
                  wifi.connected:
              - not:
                  wifi.ap_active:
          then:
            - logger.log: "Weder WLAN noch Fallback-AP - Neustart"
            - button.press: restart_button

# `logger:` is NOT here on purpose, unlike the user's other devices'
# basics file - this board needs `hardware_uart: UART0` (see
# docs/hardware.md "Programming / console UART"), which is board-
# specific, not fleet-shared. A merge key (`<<: !include`) only adds
# keys the including file doesn't already define itself - it does NOT
# deep-merge two `logger:` blocks field-by-field, so putting `logger:`
# in both places wouldn't error, it would just make this file's version
# invisible (fully shadowed by smart-ebl-display.yaml's own `logger:`).
# Keeping it out of here entirely avoids maintaining a copy that can
# never take effect.
