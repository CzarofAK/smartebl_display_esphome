# Copy this file to .basics.yaml (dot-prefixed, gitignored) and fill in
# your own OTA/API credentials before flashing.
#
# Unlike smartebl's own basic.yaml.example, there is deliberately no
# `wifi:`/`captive_portal:` block here — this board's primary network
# path is Ethernet (see README.md "Why Ethernet, not Wi-Fi 6"). Add a
# wifi: block back only once esphome/esphome#10956 (Wi-Fi 6 via the
# ESP32-C6 co-processor) is resolved and you actually want that path.

api:
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome
    id: ota_esphome
    password: !secret ota_password

web_server:
  port: 80

logger:
  level: DEBUG
  logs:
    scheduler: DEBUG

time:
  - platform: homeassistant
    id: homeassistant_time
