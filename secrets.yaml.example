# Smart EBL Display (ESP32-P4) - ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your values
# NEVER commit secrets.yaml to version control!

# Home Assistant API encryption key (generate with: openssl rand -base64 32)
api_encryption_key: "generate-a-random-32-byte-base64-key"

# OTA update password (named "password" to match the user's own
# basic.yaml.example convention across their other devices, not
# specific to this repo)
password: "your-ota-password"

# Wi-Fi 6 (via the ESP32-C6 co-processor, esp32_hosted) - this is the
# display's ACTIVE connection to Home Assistant. See README.md
# "Networking" - the onboard Ethernet PHY is a separate, optional wired
# path and has nothing to do with either this or the RS232 link to
# smartebl.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# The fallback AP's password is a plain literal in basic.yaml.example
# (matching the user's own convention there), not a secret here -
# just change the placeholder in that file directly.
